# Copy to .env and edit. Never commit .env.
POCKETLEDGER_ENV=development        # development | production

# REQUIRED in production (32+ random chars):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the SQLite file and backups live (relative paths are inside the project folder).
# On cloud hosts, point these at a persistent disk / volume.
DATABASE_PATH=instance/pocketledger.db
BACKUP_DIR=instance/backups

# HTTPS / proxy (set these when deploying behind HTTPS)
SESSION_COOKIE_SECURE=false         # true in production (default true when POCKETLEDGER_ENV=production)
FORCE_HTTPS=false                   # redirect http -> https
TRUSTED_PROXY_COUNT=0               # 1 when behind one reverse proxy (Render, Fly, Railway, nginx)

# First-run account creation through the browser. Disabled by default in production;
# either create the user from the shell (flask --app wsgi create-user) or enable this with a token.
# ALLOW_WEB_SETUP=true             # default: on in development, off in production
SETUP_TOKEN=

# REQUIRE_LOGIN=false               # false = no login screen at all (default in development). true = sign-in required (default in production).
MIN_PASSWORD_LENGTH=6              # minimum password length. 0 = no rules, blank password allowed. Raise it if the app is on the internet.
SESSION_HOURS=12
IDLE_TIMEOUT_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MAX_UPLOAD_MB=50
